{
  "name": "devops-multi-agent-team",
  "version": "0.1.0",
  "description": "DevOps multi-agent team: skill, agents, commands, language and service setup, sandbox, MCP server and Claude mod",
  "type": "module",
  "bin": {
    "devops-setup": "scripts/devops-setup.mjs",
    "devops-multi-agent-team-mcp": "mcp/server.mjs",
    "devops-research": "scripts/devops-research.mjs",
    "devops-tags": "scripts/devops-tags.mjs",
    "devops-ghas": "scripts/devops-ghas.mjs",
    "devops-comments": "scripts/devops-comments.mjs",
    "devops-stories": "scripts/devops-stories.mjs",
    "devops-cleanup": "scripts/devops-cleanup.mjs"
  },
  "scripts": {
    "check": "node scripts/check-languages.mjs",
    "test": "node scripts/check-languages.mjs && node --test scripts/devops-setup.test.mjs scripts/devops-modules.test.mjs scripts/devops-comments.test.mjs scripts/devops-stories.test.mjs scripts/devops-cleanup.test.mjs scripts/devops-formal.test.mjs mcp/server.test.mjs && claude plugin validate . && claude plugin test ."
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "LANGUAGES.md",
    "LICENSE",
    "README.md",
    "SERVICES.md",
    "agents",
    "commands",
    "hooks",
    "languages.json",
    "mcp",
    "rules",
    "scripts/check-languages.mjs",
    "scripts/devops-cleanup.mjs",
    "scripts/devops-comments.mjs",
    "scripts/devops-ghas.mjs",
    "scripts/devops-research.mjs",
    "scripts/devops-setup.mjs",
    "scripts/devops-stories.mjs",
    "scripts/devops-tags.mjs",
    "services.json",
    "skills",
    "templates",
    "types"
  ]
}
